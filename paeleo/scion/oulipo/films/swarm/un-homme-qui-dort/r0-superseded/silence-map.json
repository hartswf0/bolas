 "mix_add_helper": "import wave, numpy as np\ndef load_stem(path):\n    with wave.open(path) as w:\n        return np.frombuffer(w.readframes(w.getnframes()), \"<i2\").reshape(-1, 2) / 32767.0\ndef add_stereo(mix, wav, at, gain, pan):\n    gl = gain * 0.70710678 * min(1.0, 1.0 - pan)\n    gr = gain * 0.70710678 * min(1.0, 1.0 + pan)\n    if at < 0:                     # S-ROOM-BED starts 0.5 s before picture 0\n        wav = wav[int(round(-at * mix.rate)):]; at = 0.0\n    mix.add(wav[:, 0], at, gl, -1.0)   # mix.add(sig, at, gain, pan): pan -1 -> L only (x1.414)\n    mix.add(wav[:, 1], at, gr, +1.0)   # pan +1 -> R only; gain*0.7071*1.414 = unity\n# film time = picture time + 1.5 (Pass A) and + 38.0 (Pass B); same cues, same stems in both passes.\n# for P in (1.5, 38.0):\n#     for c in CUES: add_stereo(mix, STEM[c[\"stem\"]], P + c[\"onset\"], c[\"gain\"], c[\"pan\"])",
