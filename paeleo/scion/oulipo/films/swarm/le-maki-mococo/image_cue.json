  "#43 Collage Graph Rewriting (technique)",
  "#29 GrabCut (method, for the cutout)"
 ],
 "rig": {
  "module": "films/swarm/le-maki-mococo/gong_rig.py",
  "api": [
   "hang_layer(t, cues=None, labels=True) -> PIL RGBA 960x540",
   "events(cues=None)",
   "theta_gong(t)",
   "theta_animal(t, cues)",
   "wedge_state(k,t,cues)",
   "trajectories(cues)",
   "graph_trace(cues)"
  ],
  "timing": "assembly/pendulum/sway on twos (12 fps); fracture and first 2.6 s of sway on ones (24 fps)",
  "render_cost": "~0.3-0.45 s per frame (2x region render, cached on twos)",
  "determinism": "no randomness at render time; all seeds fixed"
 },
 "rewrite_rule": {
  "name": "replace(HangingThing.gong -> HangingThing.binturong)",
  "typed": {
   "lhs": "HangingThing{identity: gong, layer: hypothesis, anchor: Cord#1.knot}",
   "rhs": "HangingThing{identity: binturong, layer: cue, anchor: Cord#1.knot}"
  },
  "preconditions": [
   "t >= release(Q_image) = 38.00 s (P4); the engraving is never drawn before it (hang_layer checks t >= t_image)",
   "anchor unchanged: knot == (850,150) in every frame (asserted inside hang_layer)",
   "'hangs' glyph box unchanged: the editor asserts mouth_rig.glyph_table() equality across 0:24 and 0:46"
  ],
  "graphic_bridge": [
   "same cord and knot",
   "the binturong's sway begins from the gong's residual pendulum angle at 38.0 s",
   "the wedges fall in front of the animal they were hiding (occlusion reveal)"
  ],
  "sub_rules": {
   "split": "gong -> 12 wedges, released 1 per 3 frames from 38.0 s, bottom wedge first (the animal's weight tears the card from below)",
   "exit": "each wedge: ballistic fall (g=1500 px/s^2) with spin, removed once fully below frame",
   "enter": "binturong card on the plane behind the wedges from 38.0 s; parts outside the disc show at once around the intact gong (the real thing pokes out round the guess), the rest as wedges leave"
  },
  "assembly": "S2 from 11.5 s: one wedge per 2 frames clockwise from the top (holed) wedge, each lifted for 2 frames then set down (tick)",
  "honest_note": "The animal card (261 px tall, 180 px wide) is larger than the gong (166 px), so the reveal is partial occlusion, not total concealment."
 },
