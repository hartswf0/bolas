3],["that",74.33,74.61],["now",74.61,74.85],["fills",74.85,75.17],["the",75.17,75.41],["room",75.41,75.65],["and",75.65,75.87],["tell",75.87,76.11],["myself",76.11,76.69],["how",76.69,77.75],["good",77.75,78.07],["it",78.07,78.29],["is",78.29,78.51],["to",78.51,78.73],["finally",78.73,79.17],["get",79.17,79.43],["acquainted",79.43,79.83],["with",79.83,80.11],["the",80.11,80.27],["night,",80.27,80.59],["staring",81.41,81.85],["into",81.85,82.17],["unfamiliar",82.17,82.71],["yet",82.71,83.21],["relatable",83.21,83.87],["mountains",83.87,84.37],["in",84.37,84.63],["the",84.63,84.75],["distance",84.75,85.27],["and",85.27,86.25],["wandering",86.25,86.65],["eyes",86.65,87.17],["and",87.17,88.01],["wandering",88.01,88.39],["thoughts",88.39,88.85],["within",88.85,89.53],["reach.",89.53,89.81]],"scenes":[{"key":"08.0","name":"The soul leaves the dancer","t0":0.0,"t1":24.417,"img":"s0.webp","floor":714,"ppc":5.143,"shot":"MS","npcs":[{"x":984}],"lines":[{"t":0.0,"e":3.38,"text":"The soul has escaped my body for the moment and left him","w0":0,"w1":11,"mx":230},{"t":3.38,"e":4.16,"text":"on the dance floor.","w0":12,"w1":15,"mx":984},{"t":5.3,"e":6.12,"text":"He can now just be","w0":16,"w1":20,"mx":230},{"t":6.12,"e":10.44,"text":"flesh and bones, rejection and heartache hit differently when there are no","w0":21,"w1":32,"mx":984},{"t":10.44,"e":11.18,"text":"feelings afloat.","w0":33,"w1":34,"mx":230},{"t":12.94,"e":17.02,"text":"I want my soul now to imagine my body pulsing and head","w0":35,"w1":46,"mx":984},{"t":17.02,"e":20.32,"text":"throbbing from the music and empty on","w0":47,"w1":53,"mx":230},{"t":20.32,"e":23.52,"text":"a crowded floor of sweated perfumes and temptations.","w0":54,"w1":61,"mx":984}],"pieces":9,"missing_pieces":0},{"key":"08.1","name":"Strangers collide; the last one to leave","t0":24.417,"t1":41.042,"img":"s1.webp","floor":619.2,"ppc":1.895,"shot":"POV","npcs":[{"x":264},{"x":984},{"x":656}],"lines":[{"t":24.71,"e":27.29,"text":"Let's watch strangers collide and spark electric","w0":62,"w1":68,"mx":264},{"t":27.29,"e":30.07,"text":"currents that gamut the mood, a good one.","w0":69,"w1":76,"mx":984},{"t":31.47,"e":33.55,"text":"We want him to be the last one to leave,","w0":77,"w1":86,"mx":264},{"t":33.69,"e":34.53,"text":"prolonging the","w0":87,"w1":88,"mx":984},{"t":34.53,"e":39.31,"text":"bitter refraction inside the walls of an escape that few pleasures offer","w0":89,"w1":100,"mx":264},{"t":39.31,"e":39.83,"text":"us.","w0":101,"w1":101,"mx":984}],"pieces":13,"missing_pieces":0},{"key":"08.2","name":"Soul over Atlantis / the open field at the equator","t0":41.042,"t1":49.125,"img":"s2.webp","floor":604.8,"ppc":0.48,"shot":"ELS","npcs":[{"x":1152},{"x":264},{"x":984}],"lines":[{"t":41.34,"e":42.18,"text":"Now let us put my","w0":102,"w1":106,"mx":1152},{"t":42.18,"e":45.0,"text":"soul in the middle of an open field at the equator of","w0":107,"w1":118,"mx":264},{"t":45.0,"e":46.86,"text":"a planet much larger than my own","w0":119,"w1":125,"mx":984},{"t":46.86,"e":48.14,"text":"and much hotter.","w0":126,"w1":128,"mx":264}],"pieces":14,"missing_pieces":0},{"key":"08.3","name":"Angels' ice-water baptism","t0":49.125,"t1":69.25,"img":"s3.webp","floor":714,"ppc":7.579,"shot":"CU","npcs":[{"x":984}],"lines":[{"t":49.44,"e":53.26,"text":"Cool me down by pouring unfiltered water out of the ice bath","w0":129,"w1":140,"mx":230},{"t":53.26,"e":54.66,"text":"salted from the closest","w0":141,"w1":144,"mx":984},{"t":54.66,"e":60.56,"text":"moons from angels of the newest religions and its joys capturing my","w0":145,"w1":156,"mx":230},{"t":60.56,"e":62.6,"text":"body transiting in a flash of","w0":157,"w1":162,"mx":984},{"t":62.6,"e":63.32,"text":"strobe lights.","w0":163,"w1":164,"mx":230},{"t":64.45,"e":68.35,"text":"Their gracious cursor blessed me, only infinity will tell.","w0":165,"w1":173,"mx":984}],"pieces":10,"missing_pieces":0},{"key":"08.4","name":"Haze and the soul's return","t0":69.25,"t1":81.125,"img":"s4.webp","floor":714,"ppc":5.143,"shot":"MS","npcs":[],"lines":[{"t":69.53,"e":71.05,"text":"Now bring my soul back","w0":174,"w1":178,"mx":230},{"t":71.05,"e":74.85,"text":"to my body to lean back, breathe in the smoke that now","w0":179,"w1":190,"mx":1050},{"t":74.85,"e":78.07,"text":"fills the room and tell myself how good","w0":191,"w1":198,"mx":230},{"t":78.07,"e":80.59,"text":"it is to finally get acquainted with the night,","w0":199,"w1":207,"mx":1050}],"pieces":8,"missing_pieces":0},{"key":"08.5","name":"Mountains from the rooftop","t0":81.125,"t1":91.53,"img":"s5.webp","floor":619.2,"ppc":1.895,"shot":"POV","npcs":[],"lines":[{"t":81.41,"e":84.37,"text":"staring into unfamiliar yet relatable mountains","w0":208,"w1":213,"mx":230},{"t":84.37,"e":89.81,"text":"in the distance and wandering eyes and wandering thoughts within reach.","w0":214,"w1":224,"mx":1050}],"pieces":11,"missing_pieces":0}],"frame":[1280,720],"bg":"bg_08.jpg","cast":[{"key":"poet/red_black_sunglasses","dir":"poet__red_black_sunglasses"},{"key":"poet_soul/soul","dir":"poet_soul__soul"},{"key":"angel/robe","dir":"angel__robe"},{"key":"club_dress/club","dir":"club_dress__club"},{"key":"club_shirt/club","dir":"club_shirt__club"},{"key":"club_jacket/club","dir":"club_jacket__club"}]}