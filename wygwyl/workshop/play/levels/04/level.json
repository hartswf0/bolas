,{"t":39.8,"e":42.48,"text":"I'll lift it with care putting it back in place and tell","w0":91,"w1":102,"mx":230},{"t":42.48,"e":43.14,"text":"myself","w0":103,"w1":103,"mx":1050},{"t":44.07,"e":44.67,"text":"nevermore.","w0":104,"w1":104,"mx":230}],"pieces":12,"missing_pieces":0},{"key":"04.3","name":"Trail up the incline","t0":45.875,"t1":51.292,"img":"s3.webp","floor":619.2,"ppc":1.6,"shot":"","npcs":[],"lines":[{"t":46.16,"e":49.22,"text":"What if I follow this reclaimed heart to where the puzzle pieces","w0":105,"w1":116,"mx":230},{"t":49.22,"e":50.86,"text":"of faith are handcrafted","w0":117,"w1":120,"mx":1050}],"pieces":8,"missing_pieces":0},{"key":"04.4","name":"Night garden field","t0":51.292,"t1":72.792,"img":"s4.webp","floor":619.2,"ppc":1.6,"shot":"","npcs":[],"lines":[{"t":51.58,"e":56.46,"text":"scrambled and scattered as mustard seas into the vast moonlight night's field.","w0":121,"w1":132,"mx":230},{"t":56.46,"e":61.48,"text":"The plants in a golden hue bloom and face toward me in","w0":133,"w1":144,"mx":1050},{"t":61.48,"e":62.06,"text":"anticipation.","w0":145,"w1":145,"mx":230},{"t":63.43,"e":67.31,"text":"The weeds repel falling into the shadows where our memories hide and","w0":146,"w1":157,"mx":1050},{"t":67.31,"e":69.61,"text":"mean so little in moments of defeat","w0":158,"w1":164,"mx":230},{"t":69.61,"e":71.47,"text":"as I'm called forward.","w0":165,"w1":168,"mx":1050}],"pieces":14,"missing_pieces":0},{"key":"04.5","name":"Searching for hands","t0":72.792,"t1":98.958,"img":"s5.webp","floor":619.2,"ppc":1.6,"shot":"","npcs":[],"lines":[{"t":73.08,"e":76.72,"text":"The clouds meet the stars for the deepest level of darkness welcoming","w0":169,"w1":180,"mx":230},{"t":76.72,"e":78.36,"text":"extra hard work","w0":181,"w1":183,"mx":1050},{"t":78.36,"e":81.94,"text":"to search for the bare ground for two hands.","w0":184,"w1":192,"mx":230},{"t":82.36,"e":85.32,"text":"Hands that once could tusk dusk after dusk","w0":193,"w1":200,"mx":1050},{"t":85.32,"e":89.58,"text":"find and celebrate a new life and feel good","w0":201,"w1":209,"mx":230},{"t":90.48,"e":92.58,"text":"and they too used to be mine.","w0":210,"w1":216,"mx":1050},{"t":94.62,"e":97.22,"text":"I put them back on with the care of my future at","w0":217,"w1":228,"mx":230},{"t":97.22,"e":98.96,"text":"stake and say to myself","w0":229,"w1":233,"mx":1050}],"pieces":7,"missing_pieces":0},{"key":"04.6","name":"Standing in the field","t0":98.958,"t1":130.95,"img":"s6.webp","floor":619.2,"ppc":1.6,"shot":"","npcs":[],"lines":[{"t":98.96,"e":100.24,"text":"nevermore.","w0":234,"w1":234,"mx":230},{"t":102.15,"e":104.33,"text":"I've wanted the world and lost my soul.","w0":235,"w1":242,"mx":1050},{"t":105.32,"e":109.32,"text":"I want nothing more than to just be myself and nothing more","w0":243,"w1":254,"mx":230},{"t":109.8,"e":111.24,"text":"and be alright.","w0":255,"w1":257,"mx":1050},{"t":112.02,"e":113.68,"text":"I do believe I'll be alright.","w0":258,"w1":263,"mx":230},{"t":115.24,"e":121.84,"text":"This reclaimed and dust settled heart rediscovered but dusted hands remind me","w0":264,"w1":275,"mx":1050},{"t":121.84,"e":126.12,"text":"but say to me in this still muted tree in night garden","w0":276,"w1":287,"mx":230},{"t":126.12,"e":128.74,"text":"feels silence nevermore.","w0":288,"w1":290,"mx":1050},{"t":129.26,"e":129.9,"text":"Now go.","w0":291,"w1":292,"mx":230}],"pieces":9,"missing_pieces":0}],"frame":[1280,720],"bg":"bg_04.jpg","cast":[{"key":"poet/red_black_sunglasses","dir":"poet__red_black_sunglasses"}]}