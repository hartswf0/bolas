20],"bg":"bg_12.jpg","cast":[{"key":"brother_1/poem12","dir":"brother_1__poem12"},{"key":"friend_1/poem12","dir":"friend_1__poem12"},{"key":"poet/red_black_sunglasses","dir":"poet__red_black_sunglasses"},{"key":"elders/memory","dir":"elders__memory"}]}