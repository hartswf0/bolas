34.792,"img":"s1.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":12.63,"e":15.25,"text":"we look at the moon the way we used to see it","w0":27,"w1":38,"mx":230},{"t":15.28,"e":17.6,"text":"and settle down the stillnessism.","w0":39,"w1":43,"mx":1050},{"t":18.9,"e":21.28,"text":"We talk for years and travel through time","w0":44,"w1":51,"mx":230},{"t":21.8,"e":22.9,"text":"and it feels so good.","w0":52,"w1":56,"mx":1050},{"t":23.71,"e":24.73,"text":"We grow old together.","w0":57,"w1":60,"mx":230},{"t":24.91,"e":27.63,"text":"I believe maybe we could have it all,","w0":61,"w1":68,"mx":1050},{"t":27.83,"e":31.11,"text":"or swing in my humbled late nights and heartbreaks","w0":69,"w1":77,"mx":230},{"t":31.79,"e":33.45,"text":"and an end story unchanging.","w0":78,"w1":82,"mx":1050}],"pieces":21,"missing_pieces":0},{"key":"09.2","name":"Suitcases at the phone booth","t0":34.792,"t1":38.667,"img":"s2.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":35.1,"e":36.8,"text":"You help me gather my things to go.","w0":83,"w1":90,"mx":230},{"t":37.98,"e":38.58,"text":"Before I go,","w0":91,"w1":93,"mx":1050}],"pieces":24,"missing_pieces":0},{"key":"09.3","name":"The call to Mother","t0":38.667,"t1":73.375,"img":"s3.webp","floor":684.0,"ppc":3.0,"shot":"MWS","npcs":[],"lines":[{"t":38.74,"e":39.48,"text":"I call on my mother.","w0":94,"w1":98,"mx":230},{"t":40.3,"e":43.4,"text":"In tears, speaking of an abyss, she's never known.","w0":99,"w1":107,"mx":1050},{"t":44.45,"e":47.53,"text":"And we talk for years and we closet wounds","w0":108,"w1":116,"mx":230},{"t":48.34,"e":52.64,"text":"and we explain my way of birth then and even after prayer.","w0":117,"w1":128,"mx":1050},{"t":53.55,"e":55.99,"text":"What isn't mine I still cannot give.","w0":129,"w1":135,"mx":230},{"t":56.73,"e":59.73,"text":"We grow old together with the moon looking at us","w0":136,"w1":145,"mx":1050},{"t":59.73,"e":60.99,"text":"the way we used to be.","w0":146,"w1":151,"mx":230},{"t":61.72,"e":64.72,"text":"As my tears fall between the creases and faith,","w0":152,"w1":160,"mx":1050},{"t":65.38,"e":66.82,"text":"dancing on my own,","w0":161,"w1":164,"mx":230},{"t":67.62,"e":68.72,"text":"maternal ears in tune.","w0":165,"w1":168,"mx":1050},{"t":70.52,"e":72.78,"text":"She watches us gather my things to go.","w0":169,"w1":176,"mx":230}],"pieces":17,"missing_pieces":0},{"key":"09.4","name":"Father and son to the inner harbor","t0":73.375,"t1":106.083,"img":"s4.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":73.68,"e":75.38,"text":"Before I go, I call on my father.","w0":177,"w1":184,"mx":230},{"t":76.51,"e":79.05,"text":"Summon his calming demeanor from the yonders","w0":185,"w1":191,"mx":1050},{"t":79.99,"e":83.45,"text":"and we walk for years and travel east toward the sunrises","w0":192,"w1":202,"mx":230},{"t":84.47,"e":87.57,"text":"and retrace his footsteps now and then.","w0":203,"w1":209,"mx":1050},{"t":88.56,"e":91.86,"text":"Guiding a settling down moon the way it used to leave","w0":210,"w1":220,"mx":230},{"t":91.86,"e":95.08,"text":"and my tears fall between the creases","w0":221,"w1":227,"mx":1050},{"t":95.08,"e":97.18,"text":"and wave shadows of the inner harbor.","w0":228,"w1":234,"mx":230},{"t":98.39,"e":100.57,"text":"We stroll, father and son,","w0":235,"w1":239,"mx":1050},{"t":101.31,"e":102.57,"text":"hearted and shaken.","w0":240,"w1":242,"mx":230},{"t":103.51,"e":105.71,"text":"Someone borrowed and someone blew.","w0":243,"w1":247,"mx":1050}],"pieces":15,"missing_pieces":0},{"key":"09.5","name":"The EX turns to haze","t0":106.083,"t1":108.82,"img":"s5.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":106.37,"e":108.25,"text":"Yet broken, yet hurt.","w0":248,"w1":251,"mx":230}],"pieces":25,"missing_pieces":0}],"frame":[1280,720],"bg":"bg_09.jpg","cast":[{"key":"ex/ex_jacket","dir":"ex__ex_jacket"},{"key":"poet/red_black_sunglasses","dir":"poet__red_black_sunglasses"},{"key"