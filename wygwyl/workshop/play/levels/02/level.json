":[{"key":"02.0","name":"Falling with headlights off","t0":0.0,"t1":19.875,"img":"s0.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":0.0,"e":3.98,"text":"I heard a scream for help while falling with my headlights off.","w0":0,"w1":11,"mx":230},{"t":4.56,"e":7.8,"text":"It was a type of silent scream a trap lover makes to","w0":12,"w1":23,"mx":1050},{"t":7.8,"e":9.36,"text":"escape a pending marriage,","w0":24,"w1":27,"mx":230},{"t":10.04,"e":10.7,"text":"a concussion,","w0":28,"w1":29,"mx":1050},{"t":11.48,"e":16.22,"text":"a set of walls caving inward, seething and simmering,","w0":30,"w1":38,"mx":230},{"t":16.64,"e":18.76,"text":"and a solitude of crowds and smiles.","w0":39,"w1":45,"mx":1050}],"pieces":2,"missing_pieces":0},{"key":"02.1","name":"Eyes dilate","t0":19.875,"t1":45.5,"img":"s1.webp","floor":714,"ppc":7.579,"shot":"CU","npcs":[],"lines":[{"t":20.16,"e":23.22,"text":"I received an emergency call while tossing and turning.","w0":46,"w1":54,"mx":230},{"t":23.48,"e":26.98,"text":"It was a type of silent call a man makes to the","w0":55,"w1":66,"mx":1050},{"t":26.98,"e":27.92,"text":"mirror after midnight.","w0":67,"w1":69,"mx":230},{"t":28.75,"e":29.99,"text":"To digest the truth,","w0":70,"w1":73,"mx":1050},{"t":31.04,"e":35.66,"text":"a windless insomnia and epiphany of a road winding down.","w0":74,"w1":83,"mx":230},{"t":36.84,"e":41.18,"text":"After a day of life dilated at the sun as long and","w0":84,"w1":95,"mx":1050},{"t":41.18,"e":42.46,"text":"as wise as possible,","w0":96,"w1":99,"mx":230},{"t":43.41,"e":44.41,"text":"we won't make it.","w0":100,"w1":103,"mx":1050}],"pieces":5,"missing_pieces":0},{"key":"02.2","name":"Car pulls up","t0":45.5,"t1":47.917,"img":"s2.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":45.8,"e":48.04,"text":"I was six I recall when the","w0":104,"w1":110,"mx":230}],"pieces":11,"missing_pieces":0},{"key":"02.3","name":"The ghost child","t0":47.917,"t1":59.5,"img":"s3.webp","floor":663.2,"ppc":5.143,"shot":"MS","npcs":[{"x":1133}],"lines":[{"t":48.04,"e":51.42,"text":"ghost of a dead and loveless seven -year -old child appeared","w0":111,"w1":121,"mx":1133},{"t":52.2,"e":55.16,"text":"and shared that my parents marriage wouldn't last.","w0":122,"w1":129,"mx":230},{"t":56.35,"e":59.23,"text":"It was a type of warm and heavy breeze in winter","w0":130,"w1":140,"mx":1133}],"pieces":11,"missing_pieces":0},{"key":"02.4","name":"Parents arguing in the car","t0":59.5,"t1":74.583,"img":"s4.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[{"x":851}],"lines":[{"t":59.76,"e":62.09,"text":"where a child is left home alone.","w0":141,"w1":147,"mx":230},{"t":62.65,"e":67.13,"text":"With curtains pulled and blinds up as far and as wise as","w0":148,"w1":159,"mx":1050},{"t":67.13,"e":69.03,"text":"possible to see flashing lights","w0":160,"w1":164,"mx":230},{"t":69.58,"e":73.95,"text":"and the whispering screams of two souls on a road winding down.","w0":165,"w1":176,"mx":1050}],"pieces":8,"missing_pieces":0},{"key":"02.5","name":"Tambourine through the window","t0":74.583,"t1":81.58,"img":"s5.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[{"x":851}],"lines":[{"t":74.89,"e":79.19,"text":"And no tears and no fucks, no love to give,","w0":177,"w1":186,"mx":230},{"t":79.77,"e":80.75,"text":"old to teach.","w0":187,"w1":189,"mx":1050}],"pieces":12,"missing_pieces":0}],"frame":[1280,720],"bg":"bg_02.jpg","cast":[{"key":"poet/black_tshirt","dir":"poet__black_tshirt"},{"key":"young_poet/pajamas_winter","dir":"young_poet__pajamas_winter"},{"key":"ex/ex_jacket","dir":"ex__ex_jacket"},{"key":"mother/poem09","dir":"mother__poem09"},{"key":"father_02/poem02","dir":"father_02__poem02"},{"key":"ghost_child/ghost_nightclothes","dir":"ghost_child__ghost_nightclothes"}]}