,["and",84.0,84.4],["learned,",84.4,84.96],["every",86.02,86.22],["circumference",86.22,86.74],["of",86.74,87.12],["life",87.12,87.38],["we're",87.38,87.62],["celebrating",87.62,88.26],["and",88.26,88.98],["believing",88.98,89.46],["is",89.62,90.56],["here",90.56,90.98],["together",90.98,91.68],["in",91.68,92.52],["this",92.52,92.66],["sacred",92.66,93.02],["place,",93.02,93.68],["reveling",94.47,95.09],["in",95.09,95.21],["the",95.21,95.33],["sunlight",95.33,95.69],["of",95.69,95.95],["a",95.95,96.07],["new",96.07,96.23],["beginning",96.23,96.67],["with",96.67,97.65],["this",97.65,97.87],["world",97.87,98.33],["and",98.33,99.09],["a",99.09,99.19],["heart",99.19,99.53],["at",99.53,100.51],["peace.",100.51,100.81]],"scenes":[{"key":"11.0","name":"Arrival on the chilly shore","t0":0.0,"t1":15.333,"img":"s0.webp","floor":604.8,"ppc":0.48,"shot":"ELS","npcs":[],"lines":[{"t":0.34,"e":2.8,"text":"Even here is chilly in the morning.","w0":0,"w1":6,"mx":230},{"t":4.21,"e":7.19,"text":"River rafting fall covers the seas in the distance","w0":7,"w1":15,"mx":1050},{"t":7.89,"e":10.29,"text":"and hugs the bases of tree -covered hills.","w0":16,"w1":23,"mx":230},{"t":10.91,"e":12.29,"text":"This world is at peace.","w0":24,"w1":28,"mx":1050},{"t":13.69,"e":15.03,"text":"In silent resounds,","w0":29,"w1":31,"mx":230}],"pieces":11,"missing_pieces":0},{"key":"11.3","name":"Choir chords in the new nave (inferred)","t0":15.333,"t1":30.292,"img":"s1.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":15.61,"e":18.53,"text":"choir chords calm the nerves of things I can't control","w0":32,"w1":41,"mx":230},{"t":19.38,"e":22.4,"text":"and offer them as keepsakes back to the higher powers.","w0":42,"w1":51,"mx":1050},{"t":23.3,"e":26.22,"text":"Exhausted emotions carry forward a diminishing flame","w0":52,"w1":58,"mx":230},{"t":26.22,"e":30.22,"text":"to emit jazz tuned lyrics that heat and dry the morning dew.","w0":59,"w1":70,"mx":1050}],"pieces":6,"missing_pieces":0},{"key":"11.1","name":"Remnants in the sunlight","t0":30.292,"t1":35.208,"img":"s2.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":30.35,"e":34.17,"text":"All the remnants of the destruction revealed in the sunlight.","w0":71,"w1":80,"mx":230}],"pieces":10,"missing_pieces":0},{"key":"11.2","name":"The temple builds itself","t0":35.208,"t1":48.583,"img":"s3.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":35.52,"e":36.76,"text":"We can rebuild this temple.","w0":81,"w1":85,"mx":230},{"t":38.13,"e":38.89,"text":"It's a new day.","w0":86,"w1":89,"mx":1050},{"t":40.92,"e":44.74,"text":"The catharsis evoked by loss in the painful crawl","w0":90,"w1":98,"mx":230},{"t":44.74,"e":47.64,"text":"along the cobblestone boulevards of broken dreams.","w0":99,"w1":105,"mx":1050}],"pieces":8,"missing_pieces":0},{"key":"11.4","name":"Journal and the lonely mirror (inferred)","t0":48.583,"t1":75.417,"img":"s4.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":48.9,"e":51.86,"text":"I can close a chapter and open a journal stored away","w0":106,"w1":116,"mx":230},{"t":51.86,"e":53.82,"text":"from moments of great clarity.","w0":117,"w1":121,"mx":1050},{"t":54.82,"e":57.92,"text":"Words written from life's triumphs to offer a blueprint","w0":122,"w1":130,"mx":230},{"t":57.92,"e":61.54,"text":"of keeping faith alive and as majestic.","w0":131,"w1":137,"mx":1050},{"t":61.54,"e":66.79,"text":"When words are read aloud and sung alone as gospels","w0":138,"w1":147,"mx":230},{"t":66.79,"e":69.77,"text":"to the lonely mirror's midnight hours,","w0":148,"w1":153,"mx":1050},{"t":70.57,"e":74.81,"text":"the left tears drying with time that is common to past.","w0":154,"w1":164,"mx":230}],"pieces":10,"missing_pieces":0},{"key":"11.5","name":"Welcoming the new day","t0":75.417,"t1":101.27,"img":"s5.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":75.71,"e":76.95,"text":"We can embrace a new day.","w0":165,"w1":170,"mx":230},{"t":77.86,"e":79.18,"text":"We can receive a new day.","w0":171,"w1":176,"mx":1050},{"t":79.86,"e":81.66,"text":"We can welcome a new day.","w0":177,"w1":182,"mx":230},{"t":83.18,"e":84.96,"text":"Everything I've known and learned,","w0":183,"w1":187,"mx":1050},{"t":86.02,"e":89.46,"text":"every circumference of life we're celebrating and believing","w0":188,"w1":195,"mx":230},{"t":89.62,"e":93.68,"text":"is here together in this sacred place,","w0":196,"w1":202,"mx":1050},{"t":94.47,"e":96.67,"text":"reveling in the sunlight of a new beginning","w0":203,"w1":210,"mx":230},{"t":96.67,"e":100.81,"text":"with this world and a heart at peace.","w0":211,"w1":218,"mx":1050}],"pieces":6,"missing_pieces":0}],"frame":[1280,720],"bg":"bg_11.jpg","cast":[{"key":"poet/red_black_sunglasses","dir":"poet__red_black_sunglasses"}]}