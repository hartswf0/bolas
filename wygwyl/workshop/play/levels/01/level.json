t":23.48,"e":26.34,"text":"a known yet unknown pit beneath the quicksands","w0":57,"w1":64,"mx":1050},{"t":26.34,"e":27.58,"text":"of the make -believe haven,","w0":65,"w1":69,"mx":230},{"t":28.67,"e":31.97,"text":"and hidden in the overnourished forest of escapism that calls","w0":70,"w1":79,"mx":1050},{"t":31.97,"e":32.45,"text":"for you.","w0":80,"w1":81,"mx":230},{"t":33.18,"e":37.98,"text":"At this age, I'll follow, following the full distance between us almost","w0":82,"w1":93,"mx":1050},{"t":37.98,"e":39.5,"text":"having it all and","w0":94,"w1":97,"mx":230},{"t":39.5,"e":40.18,"text":"starting anew,","w0":98,"w1":99,"mx":1050},{"t":40.88,"e":42.56,"text":"to rediscover when love was real.","w0":100,"w1":105,"mx":230},{"t":43.96,"e":46.7,"text":"I failed at protecting you from your own vices,","w0":106,"w1":114,"mx":1050}],"pieces":3,"missing_pieces":0},{"key":"01.4","name":"Crashing the vintage party","t0":47.208,"t1":75.125,"img":"s4.webp","floor":619.2,"ppc":1.674,"shot":"WS","npcs":[],"lines":[{"t":47.5,"e":49.78,"text":"crashing the party of your evilest instincts","w0":115,"w1":121,"mx":230},{"t":49.78,"e":52.9,"text":"to find vibrations that echo in silence,","w0":122,"w1":128,"mx":1050},{"t":53.86,"e":57.14,"text":"love and hate languages that translate and slow","w0":129,"w1":136,"mx":230},{"t":57.14,"e":62.58,"text":"dripping blood salivating on imminent doubts, fully awakening to our darkest nights.","w0":137,"w1":148,"mx":1050},{"t":64.03,"e":65.03,"text":"Pause for a second,","w0":149,"w1":152,"mx":230},{"t":65.77,"e":69.13,"text":"a spectrum of fields will thread needles of garments made of sweet","w0":153,"w1":164,"mx":1050},{"t":69.13,"e":69.63,"text":"memories","w0":165,"w1":165,"mx":230},{"t":70.25,"e":74.57,"text":"and photographs, film and fiction that leave me empty.","w0":166,"w1":174,"mx":1050}],"pieces":7,"missing_pieces":0},{"key":"01.5","name":"Hole in the floor","t0":75.125,"t1":88.38,"img":"s5.webp","floor":504.0,"ppc":1.385,"shot":"TOP","npcs":[],"lines":[{"t":75.44,"e":79.02,"text":"With your back faced against me, you offer me a new pursuit","w0":175,"w1":186,"mx":230},{"t":79.02,"e":80.92,"text":"of happiness as I stumble","w0":187,"w1":191,"mx":1050},{"t":80.92,"e":84.5,"text":"on my own words, landing into the secret of where you go","w0":192,"w1":203,"mx":230},{"t":84.5,"e":86.34,"text":"when you leave, and I fall","w0":204,"w1":209,"mx":1050},{"t":86.34,"e":86.86,"text":"out of life.","w0":210,"w1":212,"mx":230}],"pieces":4,"missing_pieces":0}],"frame":[1280,720],"bg":"bg_01.jpg","cast":[{"key":"poet/black_tshirt","dir":"poet__black_tshirt"},{"key":"ex/ex_jacket","dir":"ex__ex_jacket"},{"key":"vintage_man/suit","dir":"vintage_man__suit"},{"key":"vintage_woman/gown","dir":"vintage_woman__gown"}]}